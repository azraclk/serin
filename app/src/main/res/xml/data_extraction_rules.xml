<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 ve sonrası için: hem bulut yedeği hem telefondan telefona aktarım aynı kurala uyar.
    Neyin neden dışarıda kaldığı backup_rules.xml içinde yazıyor.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="serin_library.xml" />
        <include domain="sharedpref" path="serin_theme.xml" />
        <include domain="sharedpref" path="player.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="serin_library.xml" />
        <include domain="sharedpref" path="serin_theme.xml" />
        <include domain="sharedpref" path="player.xml" />
    </device-transfer>
</data-extraction-rules>
